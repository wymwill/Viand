# Use localhost for demo mode. Live webhooks require a public HTTPS URL.
APP_BASE_URL=http://localhost:3000
APP_NAME=Viand

# Which transport moves messages: mock | linq | telegram.
# Leave unset to fall back to USE_MOCK_LINQ (mock when true, linq when false).
MESSAGING_PROVIDER=mock

# Obtain these from Linq. Leave blank while USE_MOCK_LINQ=true.
LINQ_API_KEY=
LINQ_PHONE_NUMBER=
# Created once by: npm run linq:register-webhook
LINQ_WEBHOOK_SECRET=
LINQ_WEBHOOK_VERSION=2026-02-03

PHONE_NUMBER_DISPLAY=(555) 555-0123
PHONE_NUMBER_E164=+15555550123

# The dashboard and local simulator run without credentials.
USE_MOCK_LINQ=true

# Telegram Bot API: free, no per-message cost. Create the bot with BotFather to
# get the token, then invent any random string for the webhook secret.
# IMPORTANT: for group chats, disable privacy mode (BotFather -> /setprivacy ->
# Disable) or the bot only receives messages that @mention it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Without the @. Used to strip the "/eat@ViandBot" suffix Telegram adds in groups.
TELEGRAM_BOT_USERNAME=
TELEGRAM_TIMEOUT_MS=10000

# Structured AI interpretation of free-text messages. Optional: with this off,
# the deterministic parser handles everything on its own.
USE_AI_INTERPRETER=false
ANTHROPIC_API_KEY=
AI_INTERPRETER_MODEL=claude-haiku-4-5
AI_INTERPRETER_TIMEOUT_MS=4000
AI_INTERPRETER_MAX_INPUT_CHARS=500
AI_INTERPRETER_MIN_CONFIDENCE=0.6

# Live restaurant data from OpenStreetMap. Keyless public endpoints are
# volunteer-run and subject to usage policies and operational limits.
USE_MOCK_RESTAURANTS=true
# Comma-separated; tried in order when one instance is overloaded.
OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter
# Cached searches are reused this long, and served stale if upstream is down.
RESTAURANT_CACHE_TTL_HOURS=168
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_USER_AGENT=Viand/0.1 (restaurant decision bot)
OSM_TIMEOUT_MS=12000
# Bounds how far the Overpass query reaches. Raise for rural areas.
OSM_MAX_QUERY_RADIUS_METRES=3000
