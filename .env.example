# Use localhost for demo mode. Live webhooks require a public HTTPS URL.
APP_BASE_URL=http://localhost:3000
APP_NAME=Viand

# Which transport moves messages: mock | linq | telegram | discord | slack.
# Leave unset to fall back to USE_MOCK_LINQ (mock when true, linq when false).
MESSAGING_PROVIDER=mock

# Obtain these from Linq. Leave blank while USE_MOCK_LINQ=true.
LINQ_API_KEY=
LINQ_PHONE_NUMBER=
# Created once by: npm run linq:register-webhook
LINQ_WEBHOOK_SECRET=
LINQ_WEBHOOK_VERSION=2026-02-03

PHONE_NUMBER_DISPLAY=(555) 555-0123
PHONE_NUMBER_E164=+15555550123

# The dashboard and local simulator run without credentials.
USE_MOCK_LINQ=true

# Telegram Bot API: free, no per-message cost. Create the bot with BotFather to
# get the token, then invent any random string for the webhook secret.
# IMPORTANT: for group chats, disable privacy mode (BotFather -> /setprivacy ->
# Disable) or the bot only receives messages that @mention it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Without the @. Used to strip the "/eat@ViandBot" suffix Telegram adds in groups.
TELEGRAM_BOT_USERNAME=
TELEGRAM_TIMEOUT_MS=10000

# Slack Events API. The signing secret verifies deliveries; the bot token sends.
# SLACK_BOT_USER_ID is the bot's own Uxxxx id, needed only to spot a mention —
# Slack renders mentions as an id, not a name, so a display name will not match.
# Subscribe to message.channels (and message.groups / message.im as needed) and
# point the Request URL at APP_BASE_URL/api/webhooks/slack.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_USER_ID=
SLACK_TIMEOUT_MS=10000

# Discord slash-command interactions. Local mock development needs none of these.
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Durable session storage over Upstash Redis's REST API (works from serverless
# without connection pooling). Leave both unset for local in-memory storage,
# which loses state on restart and is not shared across serverless invocations.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Structured AI interpretation of free-text messages. Optional: with this off,
# the deterministic parser handles everything on its own.
USE_AI_INTERPRETER=false
ANTHROPIC_API_KEY=

# `npm run eval` strategy (b) — the unstructured model baseline. Optional: with
# neither key set, the harness skips (b) and says so, and the run still works.
# Gemini is preferred when both are present, because grading the shipped scorer
# against another vendor's model is the harder claim to dismiss.
# NOTE: the Gemini free tier allows 20 generate requests per day PER MODEL,
# which is below the ~15 a single run needs once retries are counted. Use a
# billed project, or expect the run to report itself unpublishable.
GEMINI_API_KEY=
AI_INTERPRETER_MODEL=claude-haiku-4-5
AI_INTERPRETER_TIMEOUT_MS=4000
AI_INTERPRETER_MAX_INPUT_CHARS=500
AI_INTERPRETER_MIN_CONFIDENCE=0.6
# Spending caps. One chat cannot loop away a budget, and many chats each under
# their own limit cannot either. Exceeding either falls back to the rules
# parser, which answers on its own, so a cap costs coverage and never an error.
AI_INTERPRETER_MAX_CALLS_PER_CHAT=30
AI_INTERPRETER_CHAT_WINDOW_SECONDS=3600
AI_INTERPRETER_MAX_CALLS_PER_DAY=1000

# Live restaurant data from OpenStreetMap. Keyless public endpoints are
# volunteer-run and subject to usage policies and operational limits.
USE_MOCK_RESTAURANTS=true
# Comma-separated; the first valid response wins within one deadline.
OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter
# Cached searches are reused this long, and served stale if upstream is down.
RESTAURANT_CACHE_TTL_HOURS=168
# Listings kept per cached search, chosen round-robin across cuisines so a
# bounded cache keeps variety across the whole radius. Measured: at 25 a group
# with one vegetarian fell to a single option in several cities; 60 restores a
# full shortlist.
RESTAURANT_CACHE_MAX_RESULTS=60
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_USER_AGENT=Viand/0.1 (restaurant decision bot)
NOMINATIM_TIMEOUT_MS=8000
OSM_TIMEOUT_MS=30000
# Ceiling for the full-radius query; a cheap 1.5km first pass runs first.
OSM_MAX_QUERY_RADIUS_METRES=8100
